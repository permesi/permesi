# Host-side remote config for scripts/dev-up and scripts/dev-up-remote. Copy to
# .devpod.env (gitignored) and edit. Its presence makes scripts/dev-up select remote
# mode automatically; --local overrides that selection. The file is NOT touched by
# the container (unlike .envrc, which `just devpod-envrc` regenerates on every start).
#
#   cp .devpod.env.example .devpod.env

# --- Git identity + commit signing inside the workspace ---
# scripts/dev-up forwards these into the container, where configure-git.sh applies
# them after creation, on every start, and on attach. Commit signing uses your SSH
# key from the forwarded agent via ssh-keygen, so you do NOT need your host's
# 1Password/op signer program here -- leave GIT_SSH_SIGNING_PROGRAM unset.
# GIT_SIGNING_KEY is your public signing key; setting it enables SSH-signed commits.
# export GIT_USER_NAME="Your Name"
# export GIT_USER_EMAIL="you@example.com"
# export GIT_SIGNING_KEY="ssh-ed25519 AAAA..."

# --- scripts/dev-up-remote (remote VM) ---
export DEVPOD_REMOTE_PROVIDER="coyote"
# Keep this distinct from the reserved local workspace name, "permesi".
export DEVPOD_REMOTE_WORKSPACE_NAME="permesi-remote"

# Branch to run on the remote (the compose devcontainer lives on sandbox for now).
export DEVPOD_REMOTE_SOURCE="git:https://github.com/permesi/permesi.git@sandbox"

# SSH target for the post-up HAProxy reload (bloque-style HOST/USER/PORT).
export DEVPOD_REMOTE_HOST="jump"
export DEVPOD_REMOTE_USER="devops"
export DEVPOD_REMOTE_PORT="31025"
# Optional: bypass a broken system SSH configuration while keeping the explicit
# host, user, and port above. Most contributors should leave this unset.
# export DEVPOD_REMOTE_SSH_CONFIG="/dev/null"

# Remote development does not change the VM's privileged-port policy. HAProxy
# keeps serving TLS internally, while Podman publishes it on this loopback port.
export DEVPOD_REMOTE_HAPROXY_PORT="8443"

# scripts/dev-up creates an SSH tunnel from this host port to remote HAProxy. Keep
# 443 for normal https://*.permesi.localhost URLs, or use 8443 when privileged local
# ports are unavailable. Set DEVPOD_REMOTE_TUNNEL=0 to disable the tunnel.
export DEVPOD_REMOTE_LOCAL_HTTPS_PORT="443"
