# Required
# Base DSN (username/password are injected by Vault via the Agent Proxy)
PERMESI_DSN=postgres://127.0.0.1:5432/permesi
PERMESI_ADMISSION_PASERK_URL=https://genesis.permesi.localhost:8000/paserk.json

# Vault Agent Connection (Sidecar Mode)
# No RoleID/SecretID required; the Agent handles authentication.
# PERMESI_VAULT_URL defaults to unix:///run/permesi/agent.sock in systemd service.
# PERMESI_VAULT_URL=unix:///run/permesi/agent.sock

# TLS PEM bundle (Key + Cert + CA)
# PERMESI_TLS_PEM_BUNDLE=/run/permesi/tls.bundle.pem

# Optional
PERMESI_PORT=8001
PERMESI_LOG_LEVEL=info
PERMESI_FRONTEND_BASE_URL=https://permesi.example.com
PERMESI_SESSION_TTL_SECONDS=43200
PERMESI_AUTH_RATE_LIMIT_WINDOW_SECONDS=600
PERMESI_AUTH_RATE_LIMIT_IP_ATTEMPTS=100
PERMESI_AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
PERMESI_AUTH_MAX_PENDING_STATES=10000
# Additional ceiling for each purpose, not a combined pending-state total.
# Separate purpose/subject limits use PERMESI_AUTH_PENDING_*; see docs/authentication-operations.md.

# No proxy is trusted by default. Set actual trusted edge CIDRs only when the edge
# overwrites X-Real-IP; otherwise all clients share the verified proxy peer's budget.
# Loopback example for a same-host TCP proxy (leave unset without that trusted edge):
# PERMESI_AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# For the restricted same-host Unix proxy, explicitly opt in instead:
# PERMESI_AUTH_TRUST_UNIX_PROXY=true

# PostgreSQL pool (defaults shown; uncomment to override)
# PERMESI_DB_MAX_CONNECTIONS=10
# PERMESI_DB_MIN_CONNECTIONS=2
# PERMESI_DB_ACQUIRE_TIMEOUT_MS=3000
# PERMESI_DB_IDLE_TIMEOUT_SECONDS=600
# PERMESI_DB_MAX_LIFETIME_SECONDS=1800
