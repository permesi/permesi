#!/usr/bin/env sh
set -eu

# Enter the local Permesi DevPod or run one command in its workspace directory.
workspace_name="${PERMESI_DEVPOD_ID:-permesi}"
workspace_dir="${PERMESI_DEVPOD_WORKDIR:-/workspaces/permesi}"

if ! command -v devpod >/dev/null 2>&1; then
    echo "Error: devpod not found on host (https://devpod.sh)." >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    exec devpod --silent ssh "$workspace_name" --workdir "$workspace_dir"
fi

# Quote each argument for the remote shell so spaces and metacharacters remain part
# of the original argument. Use `scripts/dev-ssh sh -lc '...'` for shell expressions.
shell_quote() {
    escaped="$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
    printf "'%s'" "$escaped"
}

command_string='export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"; exec'
for arg do
    command_string="${command_string} $(shell_quote "$arg")"
done

exec devpod --silent ssh "$workspace_name" \
    --workdir "$workspace_dir" \
    --start-services=false \
    --command "$command_string"
