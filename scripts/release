#!/usr/bin/env bash
# Release flow: stage the release commit, let CI test it, then promote exactly that commit.
#
# Flow overview (`scripts/release deploy <patch|minor|major|current>`)
#   1. Preflight, before anything changes (read-only apart from a fetch): a clean
#      DEVELOP_BRANCH equal to its origin copy, MAIN_BRANCH able to fast-forward to it,
#      an authenticated gh, valid settings and a working signing setup (a throwaway
#      tag exercises the key).
#   2. Candidate: in a temporary worktree of DEVELOP_BRANCH under the git directory
#      (the checkout the deploy runs in never changes), bump the version (RELEASE_FILES
#      only), run the local verification and commit a signed "bump version to X.Y.Z".
#      The commit goes to STAGING_BRANCH only; DEVELOP_BRANCH and MAIN_BRANCH are not
#      touched yet, and the worktree is removed with whatever the build left in it.
#   3. Gate: wait for the push-triggered CI_WORKFLOW run of exactly that commit and,
#      when CANDIDATE_WORKFLOW is set, for a manual (workflow_dispatch) run of that
#      tag workflow on the candidate: it builds and packages everything and keeps the
#      artifacts with a manifest of their checksums (CANDIDATE_MANIFEST, checked here)
#      without publishing. The signed X.Y.Z tag names that run, and the tag's run only
#      uploads those checksummed artifacts: nothing is built after the tag (the crate
#      upload repackages the same source reproducibly and checks the checksum). After a
#      failure it keeps waiting RELEASE_RERUN_WAIT seconds for "Re-run failed jobs".
#   4. Promote: sign the tag on the candidate and push it to DEVELOP_BRANCH and
#      MAIN_BRANCH together with the tag in one atomic, fast-forward-only push, so the
#      three move together or not at all. Then keep SYNC_BRANCH in step and delete
#      STAGING_BRANCH. The X.Y.Z tag is the only tag the flow creates, once.
#
# The release state lives on STAGING_BRANCH (plus a local note of the candidate run
# this clone dispatched last), so `deploy` is idempotent: it
# resumes a valid candidate (one signed commit on the current DEVELOP_BRANCH, named
# "bump version to X.Y.Z", X.Y.Z untagged, and a tree identical to the bump reproduced
# on DEVELOP_BRANCH) instead of building another, replaces a stale former candidate
# (never anything else found on STAGING_BRANCH), and says "nothing to release" when
# DEVELOP_BRANCH is the last release: its tag exists and MAIN_BRANCH contains it (a
# tag MAIN_BRANCH lacks is an incomplete release, refused with the way out). Until the
# atomic push succeeds, a failed or interrupted release leaves DEVELOP_BRANCH and
# MAIN_BRANCH as they were: fix on the work branch, merge, run it again. Once it
# succeeds the release is promoted for good (the tag's run publishes it; a failed
# upload there is re-run in GitHub), and a rerun only finishes the tidy-up (sync,
# removing STAGING_BRANCH). The one change a deploy makes to the local DEVELOP_BRANCH
# is fast-forwarding it when origin's tip is exactly such a release (a run cut off
# after its push, or a release made from another clone); any other difference from
# origin is refused.
# Server-side, `protect` makes GitHub refuse any push to MAIN_BRANCH whose commit has
# not passed REQUIRED_CHECK (admins included), and the release workflow's guard
# refuses to publish a tag that is not on MAIN_BRANCH with a green CI run and the
# candidate run the signed tag names.
#
# Usage: scripts/release deploy <patch|minor|major|current>
#        scripts/release republish X.Y.Z
#        scripts/release status
#        scripts/release preflight
#        scripts/release protect
# Tuning: RELEASE_POLL_SECONDS (30), RELEASE_CI_TIMEOUT (3600), RELEASE_RERUN_WAIT
#         (900), all in seconds; RELEASE_NO_WAIT=1 stops after staging (or while CI
#         still runs) instead of waiting, so a later deploy finishes the release.
set -euo pipefail

# --- Project configuration: the only part to adapt when copying this script ---
DEVELOP_BRANCH="develop"         # set equal to MAIN_BRANCH for a trunk-only repository
MAIN_BRANCH="main"
STAGING_BRANCH="release"         # scratch branch CI must build (no "/" if CI uses branches: '*')
SYNC_BRANCH="sandbox"            # work branch kept equal to DEVELOP_BRANCH; empty disables the sync
CI_WORKFLOW="build.yml"          # workflow that runs on every branch push, STAGING_BRANCH included
REQUIRED_CHECK="CI OK"           # aggregate job in CI_WORKFLOW that branch protection requires
CANDIDATE_WORKFLOW="deploy.yml"  # tag workflow dispatched on the candidate (packages, publishes nothing); empty skips it
CANDIDATE_MANIFEST="release-manifest" # artifact the candidate run must keep for the tag to publish
MAIN_PUSH_RESTRICTIONS='{"users":["nbari"],"teams":[],"apps":[]}' # who may push to MAIN_BRANCH
REQUIRE_CONVERSATION_RESOLUTION=true # PR setting; keep what the repository already uses
OPENAPI_SPECS=(docs/openapi/permesi.json docs/openapi/genesis.json)
RELEASE_FILES=(Cargo.toml Cargo.lock "${OPENAPI_SPECS[@]}")

# The single version the whole workspace shares ([workspace.package]).
current_version() {
    local versions
    versions="$(cargo metadata --no-deps --format-version 1 | jq -r '.packages[].version' | sort -u)"
    [[ -n "${versions}" && "${versions}" != *$'\n'* ]] ||
        die "Expected a single workspace version, found: ${versions//$'\n'/, }"
    printf '%s\n' "${versions}"
}

# The workspace version recorded in a commit (used to validate staged candidates).
version_at() {
    git show "$1:Cargo.toml" | awk -F'"' '/^version = /{print $2; exit}'
}

# Change the version in RELEASE_FILES only; dependency updates are separate commits.
# The OpenAPI specs are generated from code the bump does not change, so only their
# info.version line moves; verify_locally regenerates them to prove that.
apply_bump() {
    local previous new spec
    previous="$(current_version)"
    cargo set-version --workspace --bump "$1"
    cargo update --workspace
    new="$(current_version)"
    for spec in "${OPENAPI_SPECS[@]}"; do
        if ! awk -v old="    \"version\": \"${previous}\"" -v new="    \"version\": \"${new}\"" \
            '!done && $0 == old { $0 = new; done = 1 } { print } END { exit !done }' "${spec}" >"${spec}.bump"; then
            rm -f "${spec}.bump"
            die "${spec} has no info.version line for ${previous}; run just openapi on the work branch, commit, merge, then deploy again."
        fi
        mv "${spec}.bump" "${spec}"
    done
}

# Local fast fail before the candidate is pushed; CI on that commit is the real gate.
# It runs in a fresh worktree, so the build starts clean and uses that worktree's own
# target directory, whatever CARGO_TARGET_DIR says. The specs are regenerated first:
# any difference from the version-only bump means DEVELOP_BRANCH's specs are stale.
verify_locally() {
    CARGO_TARGET_DIR="${PWD}/target" just openapi
    if ! git diff --quiet -- "${OPENAPI_SPECS[@]}"; then
        git diff --stat -- "${OPENAPI_SPECS[@]}" >&2
        echo "❌ The OpenAPI specs on ${DEVELOP_BRANCH} are out of date: run just openapi on the work branch, commit, merge, then deploy again." >&2
        return 1
    fi
    CARGO_TARGET_DIR="${PWD}/target" just verify-release
}
# --- End of project configuration ---
# Optional in the configuration block: PROTECT_TAGS=false keeps `protect` from managing
# the "Release tags" ruleset.
PROTECT_TAGS="${PROTECT_TAGS:-true}"
SYNC_NOTE=""
SYNC_INFO=""

POLL_SECONDS="${RELEASE_POLL_SECONDS:-30}"
CI_TIMEOUT="${RELEASE_CI_TIMEOUT:-3600}"
RERUN_WAIT="${RELEASE_RERUN_WAIT:-900}"
NO_WAIT="${RELEASE_NO_WAIT:-0}"

die() {
    echo "❌ $*" >&2
    exit 1
}

bump_is_valid() {
    local previous=$1 kind=$2 current=$3 pm pn pp nm nn np
    IFS=. read -r pm pn pp <<<"${previous}"
    IFS=. read -r nm nn np <<<"${current}"
    case "${kind}" in
        patch) ((nm == pm && nn == pn && np == pp + 1)) ;;
        minor) ((nm == pm && nn == pn + 1 && np == 0)) ;;
        major) ((nm == pm + 1 && nn == 0 && np == 0)) ;;
        *) return 1 ;;
    esac
}

# True when X.Y.Z version $1 is higher than $2 (plain numbers, no pre-release parts).
# Portable: no GNU `sort -V`, which macOS lacks.
version_gt() {
    local re='^[0-9]+\.[0-9]+\.[0-9]+$' a1 a2 a3 b1 b2 b3
    [[ "$1" =~ ${re} && "$2" =~ ${re} ]] || return 1
    IFS=. read -r a1 a2 a3 <<<"$1"
    IFS=. read -r b1 b2 b3 <<<"$2"
    if ((10#${a1} != 10#${b1})); then
        ((10#${a1} > 10#${b1}))
    elif ((10#${a2} != 10#${b2})); then
        ((10#${a2} > 10#${b2}))
    else
        ((10#${a3} > 10#${b3}))
    fi
}

next_version() {
    local kind=$1 major minor patch
    IFS=. read -r major minor patch <<<"$(current_version)"
    case "${kind}" in
        patch) echo "${major}.${minor}.$((patch + 1))" ;;
        minor) echo "${major}.$((minor + 1)).0" ;;
        major) echo "$((major + 1)).0.0" ;;
        *) die "Unknown release kind '${kind}' (patch, minor, major or current)." ;;
    esac
}

tag_exists() {
    git rev-parse -q --verify "refs/tags/$1" >/dev/null 2>&1
}

remote_tip() {
    git rev-parse -q --verify "refs/remotes/origin/$1" 2>/dev/null || true
}

# Canonical numbers only (no leading zeros, at most six digits): the gate uses them in
# bash arithmetic, where a leading zero would mean octal.
check_seconds() {
    local name=$1 value=$2 min=$3
    if [[ ! "${value}" =~ ^(0|[1-9][0-9]{0,5})$ ]] || ((value < min)); then
        die "${name} must be a whole number of seconds from ${min} to 999999, without leading zeros (got '${value}')."
    fi
}

# Checks that need no network: on a clean DEVELOP_BRANCH, the tools and valid settings.
check_local() {
    local branch
    branch="$(git branch --show-current)"
    [[ "${branch}" == "${DEVELOP_BRANCH}" ]] ||
        die "Not on ${DEVELOP_BRANCH} (currently on: ${branch:-a detached HEAD})."
    [[ -z "$(git status --porcelain)" ]] || die "Working directory is not clean; commit or stash first."
    for tool in cargo jq gh git; do
        command -v "${tool}" >/dev/null 2>&1 || die "${tool} is required."
    done
    local git_version git_major git_minor
    git_version="$(git version | awk '{print $3}')"
    IFS=. read -r git_major git_minor _ <<<"${git_version}"
    ((git_major > 2 || (git_major == 2 && git_minor >= 31))) ||
        die "git 2.31 or later is required (found ${git_version})."
    command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 ||
        die "sha256sum or shasum is required to check the candidate's checksums."
    cargo set-version -h >/dev/null 2>&1 || die "cargo set-version not found; install cargo-edit (cargo install cargo-edit)."
    check_seconds RELEASE_POLL_SECONDS "${POLL_SECONDS}" 5
    check_seconds RELEASE_CI_TIMEOUT "${CI_TIMEOUT}" 60
    check_seconds RELEASE_RERUN_WAIT "${RERUN_WAIT}" 0
    [[ "${NO_WAIT}" =~ ^[01]$ ]] || die "RELEASE_NO_WAIT must be 0 or 1 (got '${NO_WAIT}')."
}

# Checks against the fetched origin: DEVELOP_BRANCH equal to origin's, MAIN_BRANCH able
# to fast-forward to it, gh authenticated and a signing key that works.
check_remote() {
    local head remote probe
    head="$(git rev-parse HEAD)"
    remote="$(remote_tip "${DEVELOP_BRANCH}")"
    [[ -n "${remote}" ]] || die "origin has no ${DEVELOP_BRANCH} branch."
    if [[ "${head}" != "${remote}" ]]; then
        if git merge-base --is-ancestor "${head}" "${remote}"; then
            die "Local ${DEVELOP_BRANCH} is behind origin/${DEVELOP_BRANCH}; pull first (git pull --ff-only)."
        elif git merge-base --is-ancestor "${remote}" "${head}"; then
            die "${DEVELOP_BRANCH} has local commits origin/${DEVELOP_BRANCH} lacks; push them first."
        fi
        die "Local ${DEVELOP_BRANCH} and origin/${DEVELOP_BRANCH} have diverged; reconcile them first."
    fi
    git merge-base --is-ancestor "origin/${MAIN_BRANCH}" HEAD ||
        die "origin/${MAIN_BRANCH} has commits ${DEVELOP_BRANCH} lacks, so it cannot fast-forward; merge it into ${DEVELOP_BRANCH} first."
    gh auth status >/dev/null 2>&1 || die "gh must be authenticated to follow CI (gh auth login)."
    probe="release-signing-probe-$$"
    git tag -s "${probe}" -m "signing probe" HEAD >/dev/null 2>&1 ||
        die "git could not sign a tag; check the signing key or agent."
    git tag -d "${probe}" >/dev/null
    if [[ -n "${SSH_CONNECTION:-}" && -z "${TMUX:-}${STY:-}${ZELLIJ:-}${HERDR_ENV:-}" ]]; then
        echo "⚠️  On SSH outside a terminal multiplexer: a dropped connection stops the wait; rerun the deploy to resume."
    fi
}

# Everything a release needs, checked before anything is changed or pushed. Nothing it
# does lasts (a fetch, and a signed probe tag deleted at once); deploy passes `catch-up`
# to first fast-forward a local
# DEVELOP_BRANCH that is behind a release which already landed on origin.
preflight() {
    check_local
    git fetch --quiet --prune --tags origin
    [[ "${1:-}" != "catch-up" ]] || catch_up_released
    check_remote
    echo "✅ Release preflight passed"
}

# A version counts as released when its tag exists and origin/MAIN_BRANCH contains the
# tagged commit. The release guard publishes nothing else, so a tag anywhere else (made
# by hand, or by an older flow) is an incomplete release, never a finished one.
is_released() {
    tag_exists "$1" &&
        git merge-base --is-ancestor "$(git rev-parse "refs/tags/$1^{commit}")" "origin/${MAIN_BRANCH}" 2>/dev/null
}

# Fast-forward the clean local DEVELOP_BRANCH when it is behind origin and origin's tip
# is exactly the commit of a finished release of its own version (see is_released): a
# release that landed while this clone was not updated (a run cut off right after its
# push, or a release made from another clone). Everything it adopts has been released;
# any other difference from origin is left for check_remote to refuse.
catch_up_released() {
    local head remote version
    head="$(git rev-parse HEAD)"
    remote="$(remote_tip "${DEVELOP_BRANCH}")"
    [[ -n "${remote}" && "${head}" != "${remote}" ]] || return 0
    git merge-base --is-ancestor "${head}" "${remote}" || return 0
    version="$(version_at "${remote}" 2>/dev/null || true)"
    if [[ -z "${version}" ]] || ! is_released "${version}" ||
        [[ "$(git rev-parse "refs/tags/${version}^{commit}")" != "${remote}" ]]; then
        return 0
    fi
    git merge --quiet --ff-only "${remote}"
    echo "ℹ️  origin/${DEVELOP_BRANCH} is release ${version}; fast-forwarded local ${DEVELOP_BRANCH} to it."
}

# Throwaway worktrees live under the git directory: on the repository's disk (a build
# can be large, and /tmp is often a small tmpfs) and outside the working tree, so
# nothing in them shows up in git status. Each gets a unique path and is locked with
# the pid of the run that owns it, so concurrent runs never remove each other's and a
# killed run's worktree can be told apart from a live one.
WORKTREE_LOCK="scripts/release pid"
worktree_root() {
    git rev-parse --path-format=absolute --git-common-dir
}

# Create a detached worktree of a commit; prints its path.
add_worktree() {
    local prefix=$1 commit=$2 dir
    dir="$(mktemp -d "$(worktree_root)/${prefix}.XXXXXX")" || return 1
    if ! git worktree add --quiet --detach --lock --reason "${WORKTREE_LOCK} $$" "${dir}" "${commit}" >/dev/null 2>&1; then
        rm -rf "${dir}"
        return 1
    fi
    printf '%s' "${dir}"
}

# Remove a worktree this run created (or one proven stale by prune_stale_worktrees).
remove_worktree() {
    [[ -n "$1" ]] || return 0
    git worktree unlock "$1" >/dev/null 2>&1 || true
    git worktree remove --force "$1" >/dev/null 2>&1 || true
    rm -rf "$1"
    git worktree prune >/dev/null 2>&1 || true
}

# Remove the worktrees of runs that were killed: under worktree_root, locked by this
# script, with a pid that no longer runs. Anything else is left alone.
prune_stale_worktrees() {
    local root listing line path="" pid
    root="$(worktree_root)"
    listing="$(git worktree list --porcelain)"
    while IFS= read -r line; do
        case "${line}" in
            "worktree "*) path="${line#worktree }" ;;
            "locked ${WORKTREE_LOCK} "*)
                pid="${line##* }"
                if [[ "${path}" == "${root}/release-"* && "${pid}" =~ ^[0-9]+$ ]] && ! kill -0 "${pid}" 2>/dev/null; then
                    remove_worktree "${path}"
                    echo "ℹ️  Removed ${path}, left by a release run that was stopped."
                fi
                ;;
        esac
    done <<<"${listing}"
}

# Tracked files whose content on disk differs from the index. The index is refreshed
# first: a tool that rewrites a file with the same bytes (npm install does this to
# package-lock.json) only changes its timestamp, which plain diff-files reports.
tracked_changes() {
    git update-index -q --refresh >/dev/null 2>&1 || true
    git diff-files --name-only
}

# Whether a commit carries a signature. Presence only: GitHub verifies it against the
# account's keys when a protected branch requires signed commits.
is_signed() {
    local header
    header="$(git cat-file commit "$1")"
    header="${header%%$'\n\n'*}"
    [[ $'\n'"${header}" == *$'\ngpgsig'* ]]
}

# The tree the `kind` bump produces on top of `base`, reproduced in a throwaway
# worktree (apply_bump only, no verification); fails when it cannot be reproduced.
expected_tree() {
    local base=$1 kind=$2 dir tree=""
    dir="$(add_worktree release-check "${base}")" || return 1
    tree="$(cd "${dir}" && apply_bump "${kind}" >/dev/null 2>&1 &&
        git add -- "${RELEASE_FILES[@]}" && git write-tree 2>/dev/null)" || tree=""
    remove_worktree "${dir}"
    [[ -n "${tree}" ]] && printf '%s' "${tree}"
}

# Why a staged commit is not a resumable candidate for `version` on base, or nothing
# when it is one: a single signed commit directly on base, named "bump version to
# <version>", for a version without a tag, whose tree is byte for byte what the `kind`
# bump produces on base, so it changes the version and nothing else.
candidate_problem() {
    local sha=$1 base=$2 version=$3 kind=$4 expected
    if [[ "$(git rev-parse -q --verify "${sha}^" || true)" != "${base}" ]]; then
        echo "not on the current ${DEVELOP_BRANCH}"
    elif [[ "$(git log -1 --format=%s "${sha}")" != "bump version to ${version}" ]]; then
        echo "not named \"bump version to ${version}\""
    elif [[ "$(version_at "${sha}" || true)" != "${version}" ]]; then
        echo "its recorded version is $(version_at "${sha}" || true)"
    elif tag_exists "${version}"; then
        echo "${version} is already tagged"
    elif ! is_signed "${sha}"; then
        echo "not signed"
    elif ! expected="$(expected_tree "${base}" "${kind}")"; then
        echo "the ${kind} bump could not be reproduced to compare it"
    elif [[ "${expected}" != "$(git rev-parse "${sha}^{tree}")" ]]; then
        echo "its content is not exactly the ${kind} bump"
    fi
}

# A former candidate, which may be replaced: one commit named "bump version to X.Y.Z"
# on a DEVELOP_BRANCH commit, touching only RELEASE_FILES. Anything else found on
# STAGING_BRANCH is treated as someone's work and never overwritten.
is_former_candidate() {
    local sha=$1 parent re='^bump version to [0-9]+\.[0-9]+\.[0-9]+$'
    [[ "$(git log -1 --format=%s "${sha}")" =~ ${re} ]] || return 1
    parent="$(git rev-parse -q --verify "${sha}^" || true)"
    [[ -n "${parent}" ]] || return 1
    git merge-base --is-ancestor "${parent}" "origin/${DEVELOP_BRANCH}" || return 1
    [[ -z "$(git diff --name-only "${parent}" "${sha}" | grep -vxF -f <(printf '%s\n' "${RELEASE_FILES[@]}") || true)" ]]
}

# Build the candidate in a temporary worktree of the DEVELOP_BRANCH commit and push it
# to STAGING_BRANCH only (with a lease on whatever it held before). The checkout the
# deploy runs in is never touched, and whatever the bump or the verification leaves
# behind goes away with the worktree, also on failure or Ctrl-C. The commit holds the
# bump alone: it is made from the tree recorded before verification, so nothing the
# verification stages can reach it, and a verification that changes tracked files (in
# the index or on disk) is refused.
CANDIDATE=""
BUILD_DIR=""
BUILD_FROM=""
build_candidate() {
    local kind=$1 previous_staging=$2 base previous new changed bump_tree
    base="$(git rev-parse HEAD)"
    previous="$(current_version)"
    BUILD_FROM="$(pwd)"
    trap 'rc=$?; cd "${BUILD_FROM}"; remove_worktree "${BUILD_DIR}"; ((rc == 0)) || echo "   Nothing was staged; ${DEVELOP_BRANCH} and ${STAGING_BRANCH} are unchanged." >&2' EXIT
    trap 'exit 130' INT TERM
    BUILD_DIR="$(add_worktree release-candidate "${base}")" || die "Could not create a worktree for the candidate."
    cd "${BUILD_DIR}"
    echo "🔧 Building the ${kind} candidate from ${previous} in a temporary worktree..."
    apply_bump "${kind}"
    new="$(current_version)"
    bump_is_valid "${previous}" "${kind}" "${new}" || die "Expected a ${kind} bump from ${previous}, got ${new}."
    ! tag_exists "${new}" || die "Tag ${new} already exists."
    git add -- "${RELEASE_FILES[@]}"
    changed="$(tracked_changes)"
    [[ -z "${changed}" ]] ||
        die "The bump changed files outside RELEASE_FILES (${changed//$'\n'/, }); refusing to stage it."
    bump_tree="$(git write-tree)"
    echo "🧪 Verifying ${new} locally before staging it..."
    verify_locally
    changed="$({ git diff-index --cached --name-only "${bump_tree}"; tracked_changes; } | sort -u)"
    [[ -z "${changed}" ]] ||
        die "Verification changed tracked files (${changed//$'\n'/, }); the candidate must hold the bump alone."
    # Branch protection requires signed commits: sign explicitly, whatever commit.gpgsign says.
    CANDIDATE="$(git commit-tree -S "${bump_tree}" -p "${base}" -m "bump version to ${new}")"
    is_signed "${CANDIDATE}" || die "The candidate commit was not signed; check the signing setup."
    git push --quiet --force-with-lease="${STAGING_BRANCH}:${previous_staging}" \
        origin "${CANDIDATE}:refs/heads/${STAGING_BRANCH}" ||
        die "Could not push the candidate to ${STAGING_BRANCH} (it changed meanwhile?); run the deploy again."
    cd "${BUILD_FROM}"
    remove_worktree "${BUILD_DIR}"
    trap - EXIT INT TERM
    echo "✅ Staged ${new} as ${CANDIDATE:0:12} on ${STAGING_BRANCH}"
}

# Look up the run of a workflow for a commit, triggered by `event` (push by default)
# and, when `ref` is given, on that branch only. Prints the newest successful run (for a
# candidate run: the newest successful one that kept CANDIDATE_MANIFEST, so a stray
# manual run cannot stand in for it), otherwise the newest unfinished or failed run,
# or nothing. Fails when GitHub cannot be asked.
find_run() {
    local workflow=$1 sha=$2 event=${3:-push} ref=${4:-} args listing id conclusion first="" rc
    args=(--workflow "${workflow}" --commit "${sha}" --event "${event}" --limit 20)
    [[ -z "${ref}" ]] || args+=(--branch "${ref}")
    listing="$(gh run list "${args[@]}" --json databaseId,conclusion \
        --jq '.[] | "\(.databaseId) \(if (.conclusion // "") == "" then "-" else .conclusion end)"')" || return 1
    while read -r id conclusion; do
        [[ -n "${id}" ]] || continue
        if [[ "${conclusion}" == success ]]; then
            [[ "${event}" == workflow_dispatch ]] || { printf '%s\n' "${id}"; return 0; }
            rc=0
            run_has_manifest "${id}" || rc=$?
            ((rc != 2)) || return 1
            ((rc != 0)) || { printf '%s\n' "${id}"; return 0; }
        elif [[ -z "${first}" ]]; then
            first="${id}"
        fi
    done <<<"${listing}"
    printf '%s\n' "${first}"
}

# Whether a run still has the CANDIDATE_MANIFEST artifact: 0 yes, 1 no, 2 GitHub
# could not be asked.
run_has_manifest() {
    local names
    [[ -n "${CANDIDATE_MANIFEST}" ]] || return 0
    names="$(run_artifacts "$1")" || return 2
    [[ " ${names} " == *" ${CANDIDATE_MANIFEST} "* ]]
}

# The names of a run's artifacts that have not expired, space-separated.
run_artifacts() {
    gh api "repos/{owner}/{repo}/actions/runs/$1/artifacts" \
        --jq '[.artifacts[] | select(.expired | not) | .name] | join(" ")'
}

# Wait for the `event`-triggered (push by default) run of `workflow` for exactly this
# commit; succeed only if it passes (or a re-run of its failed jobs passes within
# RERUN_WAIT), leaving the run's id in GATE_RUN_ID. With RELEASE_NO_WAIT=1 it returns 2
# while the run is still pending. `ref` narrows the lookup to one branch, and `run`
# follows that run directly (one this deploy just dispatched).
GATE_RUN_ID=""
gate() {
    local sha=$1 workflow=$2 event=${3:-push} ref=${4:-} run_id=${5:-} deadline appear_deadline listed offline=0 url state status conclusion attempt
    local failed_at="" failed_attempt="" last="" window
    deadline=$((SECONDS + CI_TIMEOUT))
    appear_deadline=$((SECONDS + 300))
    if ((RERUN_WAIT >= 60)); then window="$((RERUN_WAIT / 60)) minutes"; else window="${RERUN_WAIT} seconds"; fi

    echo "⏳ Waiting for the ${workflow} ${event} run of ${sha:0:12}..."
    while [[ -z "${run_id}" ]]; do
        if listed="$(find_run "${workflow}" "${sha}" "${event}" "${ref}" 2>/dev/null)"; then
            offline=0
            run_id="${listed}"
            if [[ -z "${run_id}" ]] && ((SECONDS >= appear_deadline)); then
                die "No ${workflow} ${event} run appeared for ${sha} within 5 minutes."
            fi
        else
            ((offline)) || echo "⚠️  GitHub unreachable; still waiting (retrying every 10s)..."
            offline=1
            appear_deadline=$((SECONDS + 300))
            ((SECONDS < deadline)) || die "GitHub stayed unreachable; rerun the deploy when back online."
        fi
        if [[ -z "${run_id}" ]]; then
            ((NO_WAIT == 0)) || return 2
            sleep 10
        fi
    done
    url="$(gh run view "${run_id}" --json url --jq .url 2>/dev/null || echo "run ${run_id}")"
    echo "🔗 ${url}"

    while true; do
        # gh reports the conclusion of an unfinished run as "", not null: map both to "-"
        # so the three fields stay in place when read splits them.
        state="$(gh run view "${run_id}" --json status,conclusion,attempt \
            --jq '"\(.status) \(if (.conclusion // "") == "" then "-" else .conclusion end) \(.attempt)"' 2>/dev/null || echo "unknown - ?")"
        read -r status conclusion attempt <<<"${state}"
        if [[ "${status}" == "unknown" ]]; then
            if ((NO_WAIT == 1)); then
                echo "⚠️  GitHub unreachable; not waiting (RELEASE_NO_WAIT=1)."
                return 2
            fi
            [[ "${last}" == "unknown" ]] || echo "⚠️  GitHub unreachable; still waiting (retrying every ${POLL_SECONDS}s)..."
            last="unknown"
            ((SECONDS < deadline)) || die "GitHub stayed unreachable; rerun the deploy when back online."
            sleep "${POLL_SECONDS}"
            continue
        fi
        if [[ "${status} ${attempt}" != "${last}" ]]; then
            echo "   CI: ${status} (attempt ${attempt})"
            last="${status} ${attempt}"
        fi
        if [[ "${status}" == "completed" ]]; then
            if [[ "${conclusion}" == "success" ]]; then
                echo "✅ ${workflow} (${event}) passed for ${sha:0:12}"
                GATE_RUN_ID="${run_id}"
                return 0
            fi
            ((NO_WAIT == 0)) || die "${workflow} (${event}) finished with '${conclusion}': ${url}. Re-run the failed jobs or fix forward, then run the deploy again."
            # A new failure window for every failed attempt, even when a whole re-run
            # finished between two polls.
            if [[ -z "${failed_at}" || "${attempt}" != "${failed_attempt}" ]]; then
                failed_at="${SECONDS}"
                failed_attempt="${attempt}"
                echo "❌ ${workflow} (${event}) attempt ${attempt} finished with '${conclusion}': ${url}" >&2
                echo "   Re-run the failed jobs in GitHub within ${window} and this release" >&2
                echo "   continues by itself; Ctrl-C to stop waiting." >&2
            elif ((SECONDS - failed_at >= RERUN_WAIT)); then
                echo "❌ No re-run started within ${window}; nothing was released." >&2
                die "Re-run the jobs, or fix on the work branch and merge into ${DEVELOP_BRANCH}; then run the deploy again."
            fi
        elif [[ -n "${failed_at}" ]]; then
            echo "🔁 Re-run started; following attempt ${attempt}"
            failed_at=""
            deadline=$((SECONDS + CI_TIMEOUT))
        elif ((NO_WAIT == 1)); then
            return 2
        fi
        if [[ -z "${failed_at}" ]] && ((SECONDS >= deadline)); then
            die "CI did not finish within ${CI_TIMEOUT}s (${url}); when it passes, run the deploy again."
        fi
        sleep "${POLL_SECONDS}"
    done
}

# Whether a run is a usable candidate run of `sha`: prints nothing and returns 0 when it
# is a workflow_dispatch run of `sha` on `ref` (finished with success and still holding
# CANDIDATE_MANIFEST, or not finished yet, or failed and waiting for a re-run); prints
# why and returns 1 when it is not; returns 2 when GitHub cannot be asked.
candidate_run_problem() {
    local run=$1 sha=$2 ref=$3 fields head event branch status conclusion rc
    fields="$(gh run view "${run}" --json headSha,event,headBranch,status,conclusion \
        --jq '"\(.headSha) \(.event) \(.headBranch) \(.status) \(if (.conclusion // "") == "" then "-" else .conclusion end)"' 2>/dev/null)" ||
        return 2
    read -r head event branch status conclusion <<<"${fields}"
    if [[ "${head}" != "${sha}" || "${event}" != workflow_dispatch || "${branch}" != "${ref}" ]]; then
        echo "run ${run} is a ${event:-?} run of ${head:0:12} on ${branch:-?}, not of the candidate ${sha:0:12} on ${ref}"
        return 1
    fi
    if [[ "${status} ${conclusion}" == "completed success" ]]; then
        rc=0
        run_has_manifest "${run}" || rc=$?
        ((rc != 1)) || echo "run ${run} succeeded without keeping ${CANDIDATE_MANIFEST}"
        return "${rc}"
    fi
}

# Start CANDIDATE_WORKFLOW as a manual (workflow_dispatch) run on the branch that holds
# the candidate: it builds and packages everything and keeps the artifacts, and
# publishes nothing. An existing usable run of the commit on that branch is reused, and
# so is the run this clone dispatched last (its id, printed by `gh workflow run`, is
# noted in the git directory) while GitHub does not list it yet, whatever its state, so
# a rerun never starts a second run. Every run followed is checked to be of exactly
# this commit and branch. Leaves the run to follow in CANDIDATE_RUN.
CANDIDATE_RUN=""
start_candidate_run() {
    local version=$1 sha=$2 ref=$3 note noted_sha="" noted_run="" noted_at="" output problem rc _
    CANDIDATE_RUN=""
    [[ -n "${CANDIDATE_WORKFLOW}" ]] || return 0
    [[ "$(remote_tip "${ref}")" == "${sha}" ]] || die "origin/${ref} no longer holds ${sha:0:12}; run the deploy again."
    CANDIDATE_RUN="$(find_run "${CANDIDATE_WORKFLOW}" "${sha}" workflow_dispatch "${ref}" 2>/dev/null)" ||
        die "GitHub unreachable while looking for the candidate run; run the deploy again."
    [[ -z "${CANDIDATE_RUN}" ]] || return 0
    note="$(worktree_root)/release-candidate-run"
    if [[ -f "${note}" ]]; then
        read -r noted_sha noted_run noted_at <"${note}" || true
    fi
    if [[ "${noted_sha}" == "${sha}" && "${noted_run}" == pending ]] && (($(date +%s) - ${noted_at:-0} < 900)); then
        # An older gh printed no run id: give GitHub 15 minutes to list that run.
        echo "ℹ️  The candidate run dispatched earlier is not listed yet; waiting for it."
        return 0
    fi
    if [[ "${noted_sha}" == "${sha}" && "${noted_run}" =~ ^[0-9]+$ ]]; then
        rc=0
        problem="$(candidate_run_problem "${noted_run}" "${sha}" "${ref}")" || rc=$?
        ((rc != 2)) || die "GitHub unreachable while checking candidate run ${noted_run}; run the deploy again."
        if ((rc == 0)); then
            CANDIDATE_RUN="${noted_run}"
            echo "ℹ️  Following candidate run ${CANDIDATE_RUN}, dispatched earlier."
            return 0
        fi
        echo "ℹ️  Not reusing the candidate run dispatched earlier: ${problem}."
    fi
    output="$(gh workflow run "${CANDIDATE_WORKFLOW}" --ref "${ref}" 2>&1)" ||
        die "Could not start ${CANDIDATE_WORKFLOW} on ${ref}; run the deploy again. (${output})"
    CANDIDATE_RUN="$(grep -oE '/actions/runs/[0-9]+' <<<"${output}" | head -n 1 | grep -oE '[0-9]+$' || true)"
    printf '%s %s %s\n' "${sha}" "${CANDIDATE_RUN:-pending}" "$(date +%s)" >"${note}"
    echo "🚀 Started ${CANDIDATE_WORKFLOW} on ${ref}${CANDIDATE_RUN:+ (run ${CANDIDATE_RUN})}: it builds and packages ${version} without publishing."
    if [[ -n "${CANDIDATE_RUN}" ]]; then
        # The branch may have moved between the check above and the dispatch.
        rc=0
        problem="$(candidate_run_problem "${CANDIDATE_RUN}" "${sha}" "${ref}")" || rc=$?
        ((rc != 2)) || die "GitHub unreachable while checking candidate run ${CANDIDATE_RUN}; run the deploy again."
        ((rc == 0)) || die "The dispatched ${problem} (did ${ref} move?); nothing was released, run the deploy again."
        return 0
    fi
    # An older gh prints no run URL: wait until GitHub lists the run instead.
    for _ in $(seq 24); do
        CANDIDATE_RUN="$(find_run "${CANDIDATE_WORKFLOW}" "${sha}" workflow_dispatch "${ref}" 2>/dev/null || true)"
        [[ -z "${CANDIDATE_RUN}" ]] || return 0
        sleep 5
    done
    echo "⚠️  The dispatched run is not listed yet; the wait below keeps looking for it."
}

# SHA-256 of a file, on Linux and macOS.
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

# Before the tag exists, while nothing is released: download the candidate run's
# CANDIDATE_MANIFEST and every artifact it lists (its ARTIFACTS file), require the
# manifest's COMMIT and VERSION to be the candidate's, and check every file against the
# manifest's checksum lists (SHA256SUMS, *.SHA256), exactly as the tag's run will.
check_candidate_manifest() {
    local run=$1 sha=$2 version=$3 dir manifest error="" artifact list hash name file commit found listed present
    [[ -n "${CANDIDATE_MANIFEST}" ]] || return 0
    dir="$(mktemp -d "$(worktree_root)/release-manifest.XXXXXX")"
    manifest="${dir}/${CANDIDATE_MANIFEST}"
    if ! gh run download "${run}" --name "${CANDIDATE_MANIFEST}" --dir "${manifest}" >/dev/null 2>&1; then
        error="it has no downloadable ${CANDIDATE_MANIFEST}"
    elif [[ ! -s "${manifest}/ARTIFACTS" ]]; then
        error="its ${CANDIDATE_MANIFEST} lists no ARTIFACTS"
    else
        commit="$(sed -n 's/^COMMIT=//p' "${manifest}/release.env" 2>/dev/null || true)"
        found="$(sed -n 's/^VERSION=//p' "${manifest}/release.env" 2>/dev/null || true)"
        if [[ "${commit}" != "${sha}" || "${found}" != "${version}" ]]; then
            error="its manifest is for ${found:-?} at ${commit:-?}, not ${version} at ${sha}"
        fi
        while [[ -z "${error}" ]] && read -r artifact; do
            [[ -n "${artifact}" ]] || continue
            gh run download "${run}" --name "${artifact}" --dir "${dir}/artifacts/${artifact}" >/dev/null 2>&1 ||
                error="its artifact ${artifact} cannot be downloaded"
        done <"${manifest}/ARTIFACTS"
        listed=""
        for list in "${manifest}"/SHA256SUMS "${manifest}"/*.SHA256; do
            [[ -z "${error}" && -f "${list}" ]] || continue
            while [[ -z "${error}" ]] && read -r hash name; do
                name="${name#\*}"
                listed+="${name}"$'\n'
                file="$(find "${dir}/artifacts" -type f -name "${name}" -print 2>/dev/null | head -n 1)"
                if [[ -z "${file}" ]]; then
                    error="${name} from its manifest is missing"
                elif [[ "$(sha256_of "${file}")" != "${hash}" ]]; then
                    error="${name} does not match its manifest checksum"
                fi
            done <"${list}"
        done
        # Exactly the files the checksum lists name, as the tag's run requires: no list
        # missing, nothing unlisted.
        [[ -n "${error}" ]] || present="$(find "${dir}/artifacts" -type f -exec basename {} \; 2>/dev/null | sort || true)"
        if [[ -z "${error}" && -z "${listed}" ]]; then
            error="its ${CANDIDATE_MANIFEST} has no checksum list"
        elif [[ -z "${error}" && "$(sort <<<"${listed%$'\n'}")" != "${present}" ]]; then
            error="its artifacts hold files its manifest does not list ($(comm -13 <(sort <<<"${listed%$'\n'}") <(echo "${present}") | tr '\n' ' '))"
        fi
    fi
    rm -rf "${dir}"
    [[ -z "${error}" ]] ||
        die "Candidate run ${run} cannot be released: ${error}. Re-run all its jobs in GitHub, then run the deploy again. Nothing was released."
    echo "✅ Candidate run ${run}: the manifest and all its artifacts are present and match their checksums"
}

# Tag the CI-verified commit and move MAIN_BRANCH and DEVELOP_BRANCH to it in one
# atomic push; both updates must be fast-forwards, so if either branch moved since the
# candidate was built the whole push is rejected and nothing is released.
promote() {
    local version=$1 sha=$2 candidate_run=${3:-} refs message
    message=("-m" "Release version ${version}")
    # The tag names the candidate run whose artifacts its workflow run publishes.
    [[ -z "${candidate_run}" ]] || message+=("-m" "Candidate run: ${candidate_run}")
    echo "🏷️  Creating signed tag ${version} on ${sha:0:12}..."
    git tag -s "${version}" "${sha}" "${message[@]}"
    refs=("${sha}:refs/heads/${MAIN_BRANCH}")
    if [[ "${DEVELOP_BRANCH}" != "${MAIN_BRANCH}" && "$(remote_tip "${DEVELOP_BRANCH}")" != "${sha}" ]]; then
        refs+=("${sha}:refs/heads/${DEVELOP_BRANCH}")
    fi
    refs+=("refs/tags/${version}")
    echo "⬆️  Pushing ${sha:0:12} to ${MAIN_BRANCH}$([[ ${#refs[@]} -eq 3 ]] && echo " and ${DEVELOP_BRANCH}") with tag ${version} (atomic)..."
    if ! git push --atomic origin "${refs[@]}"; then
        git tag -d "${version}" >/dev/null 2>&1 || true
        die "Push rejected; nothing was released. If ${DEVELOP_BRANCH} moved meanwhile, pull it and run the deploy again for a fresh candidate."
    fi
    # The release is promoted from here on; the rest only tidies local refs and must
    # not turn a promoted release into a reported failure.
    if ! { git fetch --quiet origin && git merge --quiet --ff-only "origin/${DEVELOP_BRANCH}"; }; then
        echo "⚠️  Promoted, but local ${DEVELOP_BRANCH} is not updated yet; the next deploy fast-forwards it." >&2
    fi
    if [[ "${DEVELOP_BRANCH}" != "${MAIN_BRANCH}" ]] && git show-ref --verify --quiet "refs/heads/${MAIN_BRANCH}"; then
        if git merge-base --is-ancestor "${MAIN_BRANCH}" "origin/${MAIN_BRANCH}" 2>/dev/null; then
            git branch -f "${MAIN_BRANCH}" "origin/${MAIN_BRANCH}" >/dev/null 2>&1 || true
        else
            echo "⚠️  Local ${MAIN_BRANCH} has commits origin/${MAIN_BRANCH} lacks; left it untouched." >&2
        fi
    fi
    if [[ "${DEVELOP_BRANCH}" == "${MAIN_BRANCH}" ]]; then
        echo "✅ Promoted ${version}: ${MAIN_BRANCH} and the tag point at ${sha:0:12}"
    else
        echo "✅ Promoted ${version}: ${MAIN_BRANCH}, ${DEVELOP_BRANCH} and the tag point at ${sha:0:12}"
    fi
}

# Keep SYNC_BRANCH equal to DEVELOP_BRANCH: fast-forward it, or move it with
# --force-with-lease when its content was squash-merged (no backup ref: the old tip
# stays in the reflog of origin/<branch>); leave a branch that holds new work alone and
# say so as information (SYNC_INFO), since working on it during a release is normal.
# Only a failed update is a warning (SYNC_NOTE). Never fails the release.
sync_branch() {
    [[ -n "${SYNC_BRANCH}" ]] || return 0
    local target old local_tip
    target="$(git rev-parse HEAD)"
    if ! git fetch --quiet origin "${SYNC_BRANCH}" 2>/dev/null; then
        echo "ℹ️  origin has no ${SYNC_BRANCH} branch; nothing to sync."
        return 0
    fi
    old="$(git rev-parse "refs/remotes/origin/${SYNC_BRANCH}")"
    if [[ "${old}" == "${target}" ]]; then
        echo "✅ ${SYNC_BRANCH} matches ${DEVELOP_BRANCH} (${target:0:12})"
    elif git merge-base --is-ancestor "${target}" "${old}"; then
        SYNC_INFO="${SYNC_BRANCH} holds $(git rev-list --count "${target}..${old}") commit(s) of new work ahead of ${DEVELOP_BRANCH}; left as is: merge them into ${DEVELOP_BRANCH} when they are ready for a release."
        echo "ℹ️  ${SYNC_INFO}"
        return 0
    elif git merge-base --is-ancestor "${old}" "${target}"; then
        git push --quiet origin "${target}:refs/heads/${SYNC_BRANCH}" || {
            SYNC_NOTE="Could not fast-forward ${SYNC_BRANCH} to ${DEVELOP_BRANCH}; sync it yourself (git push origin ${target}:refs/heads/${SYNC_BRANCH})."
            echo "⚠️  ${SYNC_NOTE}" >&2
            return 0
        }
        echo "✅ ${SYNC_BRANCH} fast-forwarded to ${DEVELOP_BRANCH} (${target:0:12})"
    elif git diff --quiet "${old}" "${target}" ||
        { git rev-parse -q --verify "${target}^" >/dev/null && git diff --quiet "${old}" "${target}^"; }; then
        git push --quiet --force-with-lease="${SYNC_BRANCH}:${old}" origin "${target}:refs/heads/${SYNC_BRANCH}" || {
            SYNC_NOTE="${SYNC_BRANCH} changed on origin meanwhile, so it was left alone; it differs from ${DEVELOP_BRANCH}."
            echo "⚠️  ${SYNC_NOTE}" >&2
            return 0
        }
        echo "✅ ${SYNC_BRANCH} moved to ${DEVELOP_BRANCH}, whose content it already had; its old tip ${old:0:12} stays in the reflog of origin/${SYNC_BRANCH} (restore: git push origin ${old}:refs/heads/${SYNC_BRANCH})"
    else
        SYNC_INFO="${SYNC_BRANCH} holds changes ${DEVELOP_BRANCH} does not contain yet (new work); left as is: merge them into ${DEVELOP_BRANCH} when they are ready for a release."
        echo "ℹ️  ${SYNC_INFO}"
        return 0
    fi
    if git show-ref --verify --quiet "refs/heads/${SYNC_BRANCH}" && [[ "$(git branch --show-current)" != "${SYNC_BRANCH}" ]]; then
        local_tip="$(git rev-parse "refs/heads/${SYNC_BRANCH}")"
        if [[ "${local_tip}" == "${old}" ]] || git merge-base --is-ancestor "${local_tip}" "${target}"; then
            git branch -f "${SYNC_BRANCH}" "${target}" >/dev/null 2>&1 ||
                echo "⚠️  Could not move the local ${SYNC_BRANCH} branch (checked out in another worktree?)." >&2
        fi
    fi
    return 0
}

deploy() {
    local kind=$1 base current version staging candidate="" candidate_run="" candidate_ref problem="" rc
    preflight catch-up
    prune_stale_worktrees
    base="$(git rev-parse HEAD)"
    current="$(current_version)"
    staging="$(remote_tip "${STAGING_BRANCH}")"

    if tag_exists "${current}"; then
        if [[ "$(git rev-parse "refs/tags/${current}^{commit}")" == "${base}" ]]; then
            is_released "${current}" ||
                die "Tag ${current} is on ${DEVELOP_BRANCH} (${base:0:12}), but origin/${MAIN_BRANCH} does not contain it, so it was never released (the release guard publishes only tags on ${MAIN_BRANCH}). Release the next version instead, leaving that tag unpublished: merge any change into ${DEVELOP_BRANCH} and run the deploy again. (Where your tag rules allow deleting tags, deleting it, git push origin :refs/tags/${current} && git tag -d ${current}, lets the deploy release this commit as is.)"
            # Also finishes the tidy-up of a release whose run was cut off after its push.
            finish_release "${base}"
            echo "✅ ${DEVELOP_BRANCH} is release ${current}; nothing new to release."
            [[ -z "${SYNC_NOTE}" ]] || echo "⚠️  ${SYNC_NOTE}"
            [[ -z "${SYNC_INFO}" ]] || echo "ℹ️  ${SYNC_INFO}"
            return 0
        fi
        [[ "${kind}" != "current" ]] ||
            die "${current} is already tagged; use deploy, deploy-minor or deploy-major for a new version."
        is_released "${current}" ||
            echo "⚠️  Tag ${current} is not on origin/${MAIN_BRANCH}, so it was never published."
        version="$(next_version "${kind}")"
        ! tag_exists "${version}" || die "Tag ${version} already exists."
        [[ -z "${staging}" ]] || problem="$(candidate_problem "${staging}" "${base}" "${version}" "${kind}")"
        if [[ -n "${staging}" && -z "${problem}" ]]; then
            candidate="${staging}"
            echo "ℹ️  Resuming candidate ${version} (${candidate:0:12}) on ${STAGING_BRANCH}."
        else
            if [[ -n "${staging}" ]]; then
                is_former_candidate "${staging}" ||
                    die "${STAGING_BRANCH} holds ${staging:0:12} \"$(git log -1 --format=%s "${staging}")\", which is not a release candidate; move that work to another branch or delete ${STAGING_BRANCH}, then rerun."
                local backup="refs/backup/${STAGING_BRANCH}/${staging:0:12}"
                git update-ref "${backup}" "${staging}"
                echo "ℹ️  ${STAGING_BRANCH} holds a stale candidate (${problem}); replacing it."
                echo "   Old tip kept locally as ${backup} until its version is released; restore it with: git push origin ${backup}:refs/heads/${STAGING_BRANCH}"
            fi
            build_candidate "${kind}" "${staging}"
            candidate="${CANDIDATE}"
        fi
    else
        # DEVELOP_BRANCH carries a version with no tag (bumped by hand, or by the older
        # release flow): release that commit as it is, without a new bump.
        version="${current}"
        candidate="${base}"
        echo "ℹ️  ${DEVELOP_BRANCH} already carries the unreleased ${version}; releasing it as is."
        [[ "${kind}" == "patch" || "${kind}" == "current" ]] || echo "   Run the ${kind} deploy again afterwards for the ${kind} bump."
    fi

    # The candidate sits on STAGING_BRANCH, or is DEVELOP_BRANCH itself when its
    # untagged version is released as is.
    candidate_ref="${DEVELOP_BRANCH}"
    [[ "${candidate}" != "$(remote_tip "${STAGING_BRANCH}")" ]] || candidate_ref="${STAGING_BRANCH}"
    start_candidate_run "${version}" "${candidate}" "${candidate_ref}"
    rc=0
    candidate_run=""
    gate "${candidate}" "${CI_WORKFLOW}" || rc=$?
    if ((rc == 0)) && [[ -n "${CANDIDATE_WORKFLOW}" ]]; then
        gate "${candidate}" "${CANDIDATE_WORKFLOW}" workflow_dispatch "${candidate_ref}" "${CANDIDATE_RUN}" || rc=$?
        if ((rc == 0)); then
            candidate_run="${GATE_RUN_ID}"
            check_candidate_manifest "${candidate_run}" "${candidate}" "${version}"
        fi
    fi
    if ((rc == 2)); then
        echo "⏸️  CI is still running for ${version} (${candidate:0:12}); run the deploy again to finish."
        return 0
    fi
    ((rc == 0)) || exit "${rc}"
    promote "${version}" "${candidate}" "${candidate_run}"
    finish_release "${candidate}"
    if [[ -n "${CANDIDATE_WORKFLOW}" ]]; then
        echo "🎉 Version ${version} promoted; the ${CANDIDATE_WORKFLOW} run of tag ${version} now publishes it (see just release-status)"
    else
        echo "🎉 Version ${version} released"
    fi
    echo "🔗 Monitor the release: https://github.com/$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo "<owner>/<repo>")/actions"
    [[ -z "${SYNC_NOTE}" ]] || echo "⚠️  Released, but: ${SYNC_NOTE}"
    [[ -z "${SYNC_INFO}" ]] || echo "ℹ️  ${SYNC_INFO}"
}

# Local backups of replaced candidates (refs/backup/<STAGING_BRANCH>/*) only matter
# until their version, or a later one, is released; remove those, so no stray side
# branches pile up. Backups left by older versions of this script under
# refs/backup/<SYNC_BRANCH>/ held content DEVELOP_BRANCH already had; remove them too.
prune_backups() {
    local released=$1 ref version prefixes=("refs/backup/${STAGING_BRANCH}/")
    [[ -z "${SYNC_BRANCH}" ]] || prefixes+=("refs/backup/${SYNC_BRANCH}/")
    [[ -n "${released}" ]] || return 0
    while read -r ref; do
        [[ -n "${ref}" ]] || continue
        version="$(version_at "${ref}" 2>/dev/null || true)"
        if [[ "${ref}" == "refs/backup/${STAGING_BRANCH}/"* ]] && version_gt "${version}" "${released}"; then
            continue # a replaced candidate for a version above this release: keep it
        fi
        git update-ref -d "${ref}" &&
            echo "🧹 Removed ${ref#refs/} (${version:-no version}); ${released} is released."
    done < <(git for-each-ref --format='%(refname)' "${prefixes[@]}")
}

# After a release: bring SYNC_BRANCH in step, drop obsolete backups and remove
# STAGING_BRANCH while it still holds the released commit. Best-effort: never fails a
# release that already landed.
finish_release() {
    local released=$1
    sync_branch || true
    prune_backups "$(version_at "${released}" 2>/dev/null || true)" || true
    rm -f "$(worktree_root)/release-candidate-run"
    if [[ "$(remote_tip "${STAGING_BRANCH}")" == "${released}" ]]; then
        git push --quiet --force-with-lease="${STAGING_BRANCH}:${released}" origin ":refs/heads/${STAGING_BRANCH}" 2>/dev/null ||
            echo "ℹ️  Left ${STAGING_BRANCH} in place (it changed meanwhile)."
    fi
    return 0
}

# Read-only summary of where a release stands.
status() {
    local base current staging run state label
    git fetch --quiet --prune --tags origin
    base="$(remote_tip "${DEVELOP_BRANCH}")"
    current="$(version_at "${base}" 2>/dev/null || true)"
    if is_released "${current}"; then
        label="tagged on ${MAIN_BRANCH}"
    elif tag_exists "${current}"; then
        label="tagged, but origin/${MAIN_BRANCH} does not contain the tag: an incomplete release"
    else
        label="not released"
    fi
    echo "origin/${DEVELOP_BRANCH}: ${base:0:12} (version ${current:-?}, ${label})"
    # A tag on MAIN_BRANCH means promoted; publishing is its tag workflow run's job.
    if [[ -n "${CANDIDATE_WORKFLOW}" ]] && tag_exists "${current}"; then
        run_state "${CANDIDATE_WORKFLOW}" "$(git rev-parse "refs/tags/${current}^{commit}")" push "${current}" "publish of ${current}"
    fi
    echo "origin/${MAIN_BRANCH}:    $(remote_tip "${MAIN_BRANCH}" | cut -c1-12)"
    if [[ -n "${SYNC_BRANCH}" ]]; then
        local sync
        sync="$(remote_tip "${SYNC_BRANCH}")"
        if [[ -z "${sync}" ]]; then
            echo "origin/${SYNC_BRANCH}: none"
        elif [[ "${sync}" == "${base}" ]]; then
            echo "origin/${SYNC_BRANCH}: ${sync:0:12} (equal to ${DEVELOP_BRANCH})"
        elif git merge-base --is-ancestor "${base}" "${sync}"; then
            echo "origin/${SYNC_BRANCH}: ${sync:0:12} ($(git rev-list --count "${base}..${sync}") commit(s) of new work ahead of ${DEVELOP_BRANCH})"
        elif git merge-base --is-ancestor "${sync}" "${base}"; then
            echo "origin/${SYNC_BRANCH}: ${sync:0:12} (behind ${DEVELOP_BRANCH}; the next deploy fast-forwards it)"
        else
            echo "origin/${SYNC_BRANCH}: ${sync:0:12} (has changes ${DEVELOP_BRANCH} lacks; merge them into ${DEVELOP_BRANCH})"
        fi
    fi
    if ! tag_exists "${current}"; then
        # An untagged version is released as is: its candidate is DEVELOP_BRANCH itself.
        echo "   deploy releases ${current} as is; its runs:"
        run_state "${CI_WORKFLOW}" "${base}"
        [[ -z "${CANDIDATE_WORKFLOW}" ]] || run_state "${CANDIDATE_WORKFLOW}" "${base}" workflow_dispatch "${DEVELOP_BRANCH}"
    fi
    staging="$(remote_tip "${STAGING_BRANCH}")"
    if [[ -z "${staging}" ]]; then
        echo "${STAGING_BRANCH}: none (no staged candidate)"
        return 0
    fi
    # The same test deploy applies before resuming, the reproduced bump included.
    local subject reason="" re='^bump version to ([0-9]+\.[0-9]+\.[0-9]+)$' v="" kind="" k
    subject="$(git log -1 --format=%s "${staging}")"
    [[ ! "${subject}" =~ ${re} ]] || v="${BASH_REMATCH[1]}"
    if [[ -z "${v}" ]]; then
        reason="not a release candidate; deploy will refuse to overwrite it"
    elif ! tag_exists "${current}"; then
        reason="${DEVELOP_BRANCH} carries the unreleased ${current}, which deploy releases as is"
    elif [[ "$(git rev-parse "refs/tags/${current}^{commit}")" == "${base}" ]]; then
        reason="${DEVELOP_BRANCH} is tagged ${current}; nothing to stage (see the version line above)"
    else
        for k in patch minor major; do
            if bump_is_valid "${current}" "${k}" "${v}"; then
                kind="${k}"
                break
            fi
        done
        if [[ -z "${kind}" ]]; then
            reason="${v} is not a patch, minor or major bump of ${current}"
        else
            reason="$(candidate_problem "${staging}" "${base}" "${v}" "${kind}")"
        fi
    fi
    echo "${STAGING_BRANCH}: ${staging:0:12} \"${subject}\" ($([[ -z "${reason}" ]] && echo "${kind} candidate for ${v}; a ${kind} deploy resumes it" || echo "stale: ${reason}"))"
    run_state "${CI_WORKFLOW}" "${staging}"
    [[ -z "${CANDIDATE_WORKFLOW}" ]] || run_state "${CANDIDATE_WORKFLOW}" "${staging}" workflow_dispatch "${STAGING_BRANCH}"
}

# One status line for the `event`-triggered run of a workflow on a commit (on `ref`
# only, when given).
run_state() {
    local workflow=$1 sha=$2 event=${3:-push} ref=${4:-} label=${5:-} run state
    run="$(find_run "${workflow}" "${sha}" "${event}" "${ref}" 2>/dev/null || true)"
    if [[ -n "${run}" ]]; then
        state="$(gh run view "${run}" --json status,conclusion,attempt,url --jq '"\(.status) \(if (.conclusion // "") == "" then "-" else .conclusion end) (attempt \(.attempt)) \(.url)"' 2>/dev/null || echo "unknown")"
        echo "   ${label:-${workflow} (${event})}: ${state}"
    else
        echo "   ${label:-${workflow} (${event})}: no run found yet"
    fi
}

# Publish an existing, promoted X.Y.Z tag again when its own run cannot (a bug in the
# publish steps of the tagged workflow, or GitHub's 30-day re-run limit): a recovery run
# of CANDIDATE_WORKFLOW on MAIN_BRANCH checks the tag like its own run would and
# publishes the tag's candidate artifacts. The tag and the branches never change.
republish() {
    local version=$1 output
    [[ -n "${CANDIDATE_WORKFLOW}" ]] || die "CANDIDATE_WORKFLOW is empty; there is no tag workflow to run."
    [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Usage: scripts/release republish X.Y.Z"
    git fetch --quiet --prune --tags origin
    is_released "${version}" || die "${version} is not a promoted release (no tag on origin/${MAIN_BRANCH})."
    output="$(gh workflow run "${CANDIDATE_WORKFLOW}" --ref "${MAIN_BRANCH}" -f publish="${version}" 2>&1)" ||
        die "Could not start the recovery run: ${output}"
    echo "🚀 Started a recovery run of ${CANDIDATE_WORKFLOW} on ${MAIN_BRANCH} to publish ${version}: $(grep -oE 'https://[^ ]+/actions/runs/[0-9]+' <<<"${output}" || echo "see GitHub Actions")"
}

# Apply branch protection: MAIN_BRANCH only accepts commits whose REQUIRED_CHECK
# passed (admins included), with signed commits and linear history. Every field is
# set explicitly: GitHub keeps an omitted one (an old "lock branch" would then block
# every release push once admins are enforced). DEVELOP_BRANCH keeps signed, linear
# history without required checks (MAIN_BRANCH is the gate); STAGING_BRANCH stays
# unprotected because the release flow replaces it. No pull requests are required.
# Push restrictions (MAIN_BRANCH only) and conversation resolution come from the
# configuration, so an organization repository keeps who may push.
# Build and package the current branch exactly like a release candidate, releasing
# nothing: a manual run of CANDIDATE_WORKFLOW on the branch, which the release guard
# classifies as a candidate run. No version bump and no tag; the artifacts carry the
# branch's current version. It replaces pushing test tags, which then had to be deleted.
dry_run() {
    local branch sha output
    [[ -n "${CANDIDATE_WORKFLOW}" ]] || die "CANDIDATE_WORKFLOW is empty; there is nothing to build."
    branch="$(git branch --show-current)"
    [[ -n "${branch}" ]] || die "Check out a branch first (currently a detached HEAD)."
    [[ "${branch}" != "${STAGING_BRANCH}" ]] || die "${STAGING_BRANCH} belongs to deploy; run the dry run from another branch."
    gh auth status >/dev/null 2>&1 || die "gh must be authenticated (gh auth login)."
    git fetch --quiet origin "${branch}" 2>/dev/null || die "origin has no ${branch} branch; push it first."
    sha="$(git rev-parse HEAD)"
    [[ "$(remote_tip "${branch}")" == "${sha}" ]] ||
        die "${branch} differs from origin/${branch}; push it first (the run builds origin's copy)."
    output="$(gh workflow run "${CANDIDATE_WORKFLOW}" --ref "${branch}" 2>&1)" || die "Could not start the run: ${output}"
    echo "🚀 Started ${CANDIDATE_WORKFLOW} on ${branch} (${sha:0:12}): every test, build and package of version $(version_at HEAD), kept as artifacts; nothing is released."
    echo "🔗 $(grep -oE 'https://[^ ]+/actions/runs/[0-9]+' <<<"${output}" || echo "See the Actions tab.")"
}

protect() {
    local repo
    jq -e 'type == "null" or type == "object"' <<<"${MAIN_PUSH_RESTRICTIONS}" >/dev/null 2>&1 ||
        die "MAIN_PUSH_RESTRICTIONS must be null or a JSON object (got '${MAIN_PUSH_RESTRICTIONS}')."
    [[ "${REQUIRE_CONVERSATION_RESOLUTION}" =~ ^(true|false)$ ]] ||
        die "REQUIRE_CONVERSATION_RESOLUTION must be true or false (got '${REQUIRE_CONVERSATION_RESOLUTION}')."
    repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
    gh api -X PUT "repos/${repo}/branches/${MAIN_BRANCH}/protection" --input - >/dev/null <<EOF
{
  "required_status_checks": {"strict": false, "checks": [{"context": "${REQUIRED_CHECK}", "app_id": 15368}]},
  "enforce_admins": true,
  "required_pull_request_reviews": null,
  "restrictions": ${MAIN_PUSH_RESTRICTIONS},
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": ${REQUIRE_CONVERSATION_RESOLUTION},
  "lock_branch": false,
  "allow_fork_syncing": false
}
EOF
    if [[ "${DEVELOP_BRANCH}" != "${MAIN_BRANCH}" ]]; then
        gh api -X PUT "repos/${repo}/branches/${DEVELOP_BRANCH}/protection" --input - >/dev/null <<EOF
{
  "required_status_checks": null,
  "enforce_admins": false,
  "required_pull_request_reviews": null,
  "restrictions": null,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": ${REQUIRE_CONVERSATION_RESOLUTION},
  "lock_branch": false,
  "allow_fork_syncing": false
}
EOF
    fi
    for branch in "${MAIN_BRANCH}" "${DEVELOP_BRANCH}"; do
        gh api -X POST "repos/${repo}/branches/${branch}/protection/required_signatures" >/dev/null
    done
    echo "✅ ${MAIN_BRANCH} requires '${REQUIRED_CHECK}' (admins included); ${DEVELOP_BRANCH} and ${MAIN_BRANCH} require signed, linear history."
    [[ "${PROTECT_TAGS}" == true ]] || return 0
    protect_tags "${repo}"
}

# A published version is immutable: the "Release tags" ruleset lets X.Y.Z tags be
# created but never moved or deleted, by anyone (no bypass actors), so a release can
# never be rewritten after the fact. Other tags (t-* test tags) are not covered.
# Idempotent: it updates the ruleset of that name, or creates it.
protect_tags() {
    local repo=$1 id body
    body='{
  "name": "Release tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"include": ["refs/tags/[0-9]*.[0-9]*.[0-9]*"], "exclude": []}},
  "rules": [{"type": "update"}, {"type": "deletion"}, {"type": "non_fast_forward"}]
}'
    id="$(gh api "repos/${repo}/rulesets" --jq '.[] | select(.name == "Release tags" and .target == "tag") | .id')"
    if [[ -n "${id}" ]]; then
        gh api -X PUT "repos/${repo}/rulesets/${id}" --input - >/dev/null <<<"${body}"
    else
        gh api -X POST "repos/${repo}/rulesets" --input - >/dev/null <<<"${body}"
    fi
    echo "✅ X.Y.Z tags can be created but never moved or deleted (ruleset \"Release tags\")."
}

usage() {
    sed -n '/^# Usage:/,/^#         still runs/p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
    deploy) deploy "${2:-patch}" ;;
    republish) republish "${2:-}" ;;
    status) status ;;
    preflight) preflight ;;
    dry-run) dry_run ;;
    protect) protect ;;
    help | -h | --help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
