#!/usr/bin/env python3
"""Publish approved admission public keys in core OpenBao using KV v2 CAS.

The core connection uses the operator's bao CLI environment. An isolated edge
can supply public Transit metadata through a dedicated read-only Agent socket.
Only initialize uses CAS zero. Publication retains the floor. Withdrawal can
raise the floor past all existing versions before a replacement key is ready.
"""
import argparse
import base64
import json
import os
from pathlib import Path
import subprocess

RECORD = "admission-authority"


def read(command):
    result = subprocess.run(command, stdout=subprocess.PIPE, check=True)
    return json.loads(result.stdout)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("initialize", "publish", "withdraw"))
    parser.add_argument("version", type=int)
    parser.add_argument("--mount", default="secret/permesi")
    parser.add_argument("--reader-socket", type=Path)
    args = parser.parse_args()
    if not 1 <= args.version <= 2**32 - 1:
        parser.error("version must be a positive Transit key version")
    mount = "-mount=" + args.mount
    if args.operation == "initialize":
        revision, floor, keys = 0, args.version, {}
    else:
        data = read(["bao", "kv", "get", "-format=json", mount, RECORD])["data"]
        revision = data["metadata"]["version"]
        floor = data["data"]["minimum_version"]
        keys = data["data"]["keys"]
        if type(revision) is not int or revision <= 0 or type(floor) is not int or floor < 1:
            parser.error("invalid core authority record")
    if args.version < floor:
        parser.error("requested version is below the withdrawal floor")
    if args.operation == "withdraw":
        if args.version == floor:
            parser.error("withdrawal requires a higher minimum version")
        floor = args.version
        keys = {v: key for v, key in keys.items() if int(v) >= floor}
    else:
        path = "transit/genesis/keys/genesis-signing"
        if args.reader_socket:
            if not args.reader_socket.is_absolute() or not args.reader_socket.is_socket():
                parser.error("the isolated reader requires an absolute Agent socket")
            metadata = read(["curl", "--disable", "--fail", "--silent", "--show-error",
                             "--max-time", "5", "--max-filesize", "1048576", "--noproxy", "*",
                             "--unix-socket", os.fspath(args.reader_socket), "http://localhost/v1/" + path])
        else:
            metadata = read(["bao", "read", "-format=json", path])
        transit = metadata["data"]
        if transit["type"] != "ed25519":
            parser.error("expected an Ed25519 Transit key")
        version = str(args.version)
        key = transit["keys"][version]["public_key"]
        if len(base64.b64decode(key, validate=True)) != 32 or keys.get(version, key) != key:
            parser.error("invalid or substituted public key")
        if keys and args.version < max(map(int, keys)):
            parser.error("cannot republish a retired version")
        keys[version] = key
        keys = dict(sorted(keys.items(), key=lambda item: int(item[0]))[-2:])
    payload = json.dumps({"minimum_version": floor, "keys": keys})
    subprocess.run(["bao", "kv", "put", mount, "-cas=" + str(revision), RECORD, "-"],
                   input=payload, text=True, check=True, stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
